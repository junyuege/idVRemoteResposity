<view class="page-wrap home-page">
  <view class="hero">
    <image class="hero-cover" src="/images/placeholder/cover.png" mode="aspectFill" />
    <view class="hero-shade"></view>
    <view class="hero-content">
      <text class="hero-kicker">IDENTITY V STRATEGY</text>
      <text class="hero-title">加页手记攻略</text>
      <text class="hero-sub">路线、入口与物资信息集中查询</text>
      <view class="hero-actions">
        <button class="primary-btn hero-action" bindtap="goToCategory">查看教学</button>
        <button class="secondary-btn hero-action" bindtap="goToInventory">打开图鉴</button>
      </view>
    </view>
  </view>

  <view wx:if="{{recent}}" class="recent-card" bindtap="onRecentTap">
    <view class="recent-mark">最</view>
    <view class="recent-body">
      <text class="recent-kicker">最近查看</text>
      <text class="recent-title">{{recent.mapName}} · {{recent.author}}</text>
      <text class="recent-sub">{{recent.summary}}</text>
    </view>
    <text class="list-arrow">›</text>
  </view>

  <view class="section-title-row">
    <text class="section-title">路线攻略</text>
    <text class="section-meta">{{strategies.length}} 个攻略版本</text>
  </view>

  <view wx:if="{{loading}}" class="loading-wrap">
    <view class="loading-dot"></view>
    <text>正在整理攻略...</text>
  </view>

  <view wx:elif="{{strategies.length === 0}}" class="empty-wrap">
    <text>暂时没有可用攻略</text>
  </view>

  <view wx:else class="strategy-list">
    <view wx:for="{{strategies}}" wx:key="_id" class="strategy-card" data-id="{{item.mapId}}" data-authorid="{{item.authorId}}" bindtap="onStrategyTap">
      <view class="strategy-head">
        <image class="strategy-cover" src="{{item.coverImage}}" mode="aspectFill" />
        <view class="strategy-title-wrap">
          <text class="strategy-title">{{item.title}}</text>
          <text class="strategy-sub">{{item.difficulty}} · {{item.routes.length}} 个难度</text>
        </view>
        <text class="list-arrow">›</text>
      </view>
      <view class="mode-groups">
        <view class="mode-row">
          <button
            wx:for="{{item.shortRoutes}}"
            wx:for-item="route"
            wx:key="id"
            class="mode-btn {{currentMode === route.id ? 'mode-active' : ''}}"
            data-mode="{{route.id}}"
            data-mapId="{{item.mapId}}"
            data-authorid="{{item.authorId}}"
            catchtap="onSelectMode"
          >{{route.label}}</button>
        </view>
        <view wx:if="{{item.longRoutes.length}}" class="mode-row">
          <button
            wx:for="{{item.longRoutes}}"
            wx:for-item="route"
            wx:key="id"
            class="mode-btn mode-wide {{currentMode === route.id ? 'mode-active' : ''}}"
            data-mode="{{route.id}}"
            data-mapId="{{item.mapId}}"
            data-authorid="{{item.authorId}}"
            catchtap="onSelectMode"
          >{{route.label}}</button>
        </view>
      </view>
    </view>
  </view>

  <button class="share-fab" open-type="share" aria-label="分享攻略">↗</button>
</view>
