<view class="page-wrap">
  <view class="panel" style="padding:24px 20px;margin-bottom:20px;background:linear-gradient(135deg,#2a2b32,#1c1d22);">
    <view style="font-size:32px;font-weight:800;color:#ff9c00;">第五人格</view>
    <view style="font-size:18px;font-weight:600;color:#fff;margin-top:4px;">加页手记攻略查询</view>
    <view style="font-size:12px;color:#aaa;margin-top:8px;">地图路线、物资点位、通关技巧</view>
    <view style="display:flex;margin-top:18px;gap:10px;">
      <view bindtap="goToCategory" style="padding:10px 22px;border-radius:6px;font-size:13px;font-weight:600;background:#ff9c00;color:#1c1d22;">小抄教学</view>
      <view bindtap="goToInventory" style="padding:10px 22px;border-radius:6px;font-size:13px;font-weight:600;background:#3a3b44;color:#ddd;">全部小抄整理</view>
    </view>
  </view>

  <view style="font-size:18px;font-weight:700;color:#ff9c00;margin:0 0 12px 2px;">攻略分类</view>
  <view wx:for="{{strategies}}" wx:key="_id" class="panel" style="display:flex;min-height:100px;margin-bottom:12px;" data-id="{{item._id}}" bindtap="onStrategyTap">
    <image src="{{item.coverImage}}" mode="aspectFill" style="width:120px;min-width:120px;height:100px;background:#333;" />
    <view style="flex:1;padding:12px 14px;min-width:0;">
      <view style="font-size:15px;font-weight:600;color:#fff;line-clamp:2;overflow:hidden;">{{item.title}}</view>
      <view style="display:flex;align-items:center;margin-top:8px;gap:8px;">
        <text style="font-size:11px;color:#999;">{{item.author}}</text>
        <text class="tag {{item.difficultyTagClass}}">{{item.difficultyTag}}</text>
      </view>
      <view style="font-size:12px;color:#bbb;margin-top:6px;line-clamp:2;overflow:hidden;">{{item.summary}}</view>
    </view>
  </view>

  <view style="font-size:18px;font-weight:700;color:#ff9c00;margin:12px 0 12px 2px;">更多功能</view>
  <view class="panel" style="display:flex;align-items:center;padding:14px;margin-bottom:10px;" bindtap="goToInventory">
    <view style="width:44px;height:44px;border-radius:8px;background:#33343d;display:flex;align-items:center;justify-content:center;font-size:22px;margin-right:12px;">📦</view>
    <view style="flex:1;">
      <view style="font-size:15px;font-weight:600;color:#fff;">回收图鉴</view>
      <view style="font-size:11px;color:#999;margin-top:3px;">查看所有可回收物品及价格</view>
    </view>
    <text style="font-size:24px;color:#ff9c00;">›</text>
  </view>
  <view class="panel" style="display:flex;align-items:center;padding:14px;margin-bottom:10px;" bindtap="goToInventory">
    <view style="width:44px;height:44px;border-radius:8px;background:#33343d;display:flex;align-items:center;justify-content:center;font-size:22px;margin-right:12px;">🎒</view>
    <view style="flex:1;">
      <view style="font-size:15px;font-weight:600;color:#fff;">物品图鉴</view>
      <view style="font-size:11px;color:#999;margin-top:3px;">道具、材料、装备一览</view>
    </view>
    <text style="font-size:24px;color:#ff9c00;">›</text>
  </view>

  <button class="float-btn" open-type="share">分享</button>
</view>