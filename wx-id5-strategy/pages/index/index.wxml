<view class="page-wrap home-page">
  <view class="hero">
    <image class="hero-cover" src="/images/placeholder/cover.png" mode="aspectFill" />
    <view class="hero-shade"></view>
    <view class="hero-content">
      <text class="hero-kicker">IDENTITY V STRATEGY</text>
      <text class="hero-title">加页手记攻略</text>
      <text class="hero-sub">路线、入口与物资信息集中查询</text>
      <view class="hero-actions">
        <button class="primary-btn hero-action" bindtap="goToCategory">查看教学</button>
        <button class="secondary-btn hero-action" bindtap="goToInventory">打开图鉴</button>
      </view>
    </view>
  </view>

  <view wx:if="{{announcement && !announcementDismissed}}" class="announce-banner" bindtap="openAnnouncement">
    <text class="announce-chip">公告</text>
    <text class="announce-text">{{announcement.title}}</text>
    <text class="announce-close" catchtap="dismissAnnouncement" aria-label="关闭公告">×</text>
  </view>

  <view class="section-title-row">
    <text class="section-title">路线攻略</text>
    <text class="section-meta">{{strategies.length}} 个攻略版本</text>
  </view>

  <view wx:if="{{loading}}" class="loading-wrap">
    <view class="loading-dot"></view>
    <text>正在整理攻略...</text>
  </view>

  <view wx:elif="{{strategies.length === 0}}" class="empty-wrap">
    <text>暂时没有可用攻略</text>
  </view>

  <view wx:else class="strategy-list">
    <view wx:for="{{strategies}}" wx:key="_id" class="strategy-card" data-id="{{item.mapId}}" data-authorid="{{item.authorId}}" bindtap="onStrategyTap">
      <view class="strategy-head">
        <image class="strategy-cover" src="{{item.coverImage}}" mode="aspectFill" />
        <view class="strategy-title-wrap">
          <text class="strategy-title">{{item.title}}</text>
          <text class="strategy-sub">{{item.difficulty}} · {{item.routes.length}} 个难度</text>
        </view>
        <text class="list-arrow">›</text>
      </view>
      <view class="mode-groups">
        <view class="mode-row">
          <button
            wx:for="{{item.shortRoutes}}"
            wx:for-item="route"
            wx:key="id"
            class="mode-btn {{currentMode === route.id ? 'mode-active' : ''}}"
            data-mode="{{route.id}}"
            data-mapId="{{item.mapId}}"
            data-authorid="{{item.authorId}}"
            catchtap="onSelectMode"
          >{{route.label}}</button>
        </view>
        <view wx:if="{{item.longRoutes.length}}" class="mode-row">
          <button
            wx:for="{{item.longRoutes}}"
            wx:for-item="route"
            wx:key="id"
            class="mode-btn mode-wide {{currentMode === route.id ? 'mode-active' : ''}}"
            data-mode="{{route.id}}"
            data-mapId="{{item.mapId}}"
            data-authorid="{{item.authorId}}"
            catchtap="onSelectMode"
          >{{route.label}}</button>
        </view>
      </view>
    </view>
  </view>

  <button wx:if="{{recentHistory.length}}" class="history-fab" bindtap="openHistorySheet" aria-label="查看历史记录">
    <text class="history-fab-icon">史</text>
    <text class="history-fab-badge">{{recentHistory.length}}</text>
  </button>

  <button class="share-fab" open-type="share" aria-label="分享攻略">↗</button>

  <view wx:if="{{showHistory}}" class="history-mask" bindtap="closeHistorySheet"></view>
  <view wx:if="{{showHistory}}" class="history-sheet" catchtap="preventClose">
    <view class="sheet-handle"></view>
    <view class="history-sheet-head">
      <view>
        <text class="history-sheet-kicker">HISTORY</text>
        <text class="history-sheet-title">最近记录</text>
      </view>
      <view class="history-sheet-actions">
        <text wx:if="{{recentHistory.length > 2}}" class="history-action" bindtap="toggleRecentHistory">{{recentExpanded ? '收起' : '展开'}}</text>
        <text class="history-action" bindtap="clearRecentHistory">清空</text>
        <button class="sheet-close" bindtap="closeHistorySheet" aria-label="关闭">×</button>
      </view>
    </view>
    <view wx:if="{{recentHistoryVisible.length}}" class="history-sheet-list">
      <view
        wx:for="{{recentHistoryVisible}}"
        wx:key="ts"
        class="history-sheet-row"
        data-index="{{index}}"
        bindtap="onHistoryTap"
      >
        <view class="history-sheet-body">
          <text class="history-sheet-name">{{item.mapName}} · {{item.author}}</text>
          <text class="history-sheet-sub">{{item.summary}}</text>
        </view>
        <text class="list-arrow">›</text>
      </view>
    </view>
    <view wx:else class="empty-wrap compact-empty"><text>暂无历史记录</text></view>
  </view>

  <view wx:if="{{showAnnouncement}}" class="history-mask" bindtap="closeAnnouncement"></view>
  <view wx:if="{{showAnnouncement}}" class="history-sheet" catchtap="preventClose">
    <view class="sheet-handle"></view>
    <view class="history-sheet-head">
      <view>
        <text class="history-sheet-kicker">NOTICE</text>
        <text class="history-sheet-title">{{announcement.title}}</text>
      </view>
      <button class="sheet-close" bindtap="closeAnnouncement" aria-label="关闭">×</button>
    </view>
    <scroll-view scroll-y class="announce-content-wrap">
      <text class="announce-content">{{announcement.content}}</text>
    </scroll-view>
    <text class="announce-time">轻触空白处关闭</text>
  </view>
</view>
