.home-page { padding-top: 12px; }

.hero {
  position: relative;
  height: 224px;
  overflow: hidden;
  background: #23242a;
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 8px;
}

.hero-cover {
  position: absolute;
  width: 100%;
  height: 100%;
}

.hero-shade {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: linear-gradient(90deg, rgba(18, 19, 23, 0.97) 0%, rgba(18, 19, 23, 0.86) 58%, rgba(18, 19, 23, 0.28) 100%);
}

.hero-content {
  position: relative;
  z-index: 1;
  display: flex;
  height: 100%;
  padding: 24px 20px;
  flex-direction: column;
  justify-content: center;
}

.hero-kicker {
  color: #d89b3c;
  font-size: 10px;
  font-weight: 700;
}

.hero-title {
  margin-top: 7px;
  color: #fff;
  font-size: 27px;
  font-weight: 800;
  line-height: 1.25;
}

.hero-sub {
  margin-top: 7px;
  color: #a8a9ae;
  font-size: 13px;
}

.hero-actions { display: flex; gap: 9px; margin-top: 21px; }
.hero-action { width: 104px; min-height: 40px; font-size: 13px; }

.strategy-list { display: flex; flex-direction: column; gap: 12px; }

.strategy-card {
  padding: 14px;
  background: #22242a;
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 8px;
}

.strategy-card:active { background: #272930; }
.strategy-head { display: flex; align-items: center; }

.strategy-cover {
  width: 52px;
  height: 52px;
  flex-shrink: 0;
  margin-right: 12px;
  background: #30323a;
  border-radius: 6px;
}

.strategy-title-wrap { flex: 1; min-width: 0; }
.strategy-title { display: block; color: #f5f3ef; font-size: 16px; font-weight: 700; }
.strategy-sub { display: block; margin-top: 4px; color: #858790; font-size: 12px; }

.mode-groups {
  display: flex;
  margin-top: 14px;
  padding-top: 12px;
  flex-direction: column;
  gap: 8px;
  border-top: 1px solid rgba(255, 255, 255, 0.06);
}

.mode-row { display: flex; gap: 8px; }

.mode-btn {
  min-width: 56px;
  height: 32px;
  padding: 0 12px;
  background: #2d2f36;
  border: 1px solid rgba(255, 255, 255, 0.07);
  border-radius: 5px;
  color: #b9bac0;
  font-size: 12px;
  line-height: 30px;
}

.mode-wide { flex: 1; }
.mode-btn:active, .mode-active { background: #3a3021; border-color: rgba(216, 155, 60, 0.5); color: #efbd6d; }

.recent-card {
  display: flex;
  align-items: center;
  margin: 18px 0 4px;
  padding: 12px;
  background: #22242a;
  border: 1px solid rgba(216, 155, 60, 0.28);
  border-radius: 8px;
}

.recent-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 38px;
  height: 38px;
  margin-right: 11px;
  flex-shrink: 0;
  background: #3a3021;
  border-radius: 6px;
  color: #efbd6d;
  font-size: 14px;
  font-weight: 700;
}

.recent-body { flex: 1; min-width: 0; }
.recent-kicker { display: block; color: #d89b3c; font-size: 10px; font-weight: 700; }
.recent-title { display: block; margin-top: 3px; color: #f5f3ef; font-size: 14px; font-weight: 700; }
.recent-sub {
  display: block;
  margin-top: 3px;
  overflow: hidden;
  color: #858790;
  font-size: 12px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.history-panel {
  margin: 12px 0 2px;
  overflow: hidden;
  background: #1f2127;
  border: 1px solid rgba(255, 255, 255, 0.07);
  border-radius: 8px;
}

.history-head {
  display: flex;
  padding: 10px 12px;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1px solid rgba(255, 255, 255, 0.06);
}

.history-title { color: #c9c9cf; font-size: 12px; font-weight: 700; }
.history-actions { display: flex; align-items: center; gap: 12px; }
.history-clear { color: #d89b3c; font-size: 12px; }

.history-row {
  display: flex;
  min-height: 54px;
  padding: 10px 12px;
  align-items: center;
  border-bottom: 1px solid rgba(255, 255, 255, 0.05);
}

.history-row:last-child { border-bottom: 0; }
.history-body { flex: 1; min-width: 0; }
.history-name { display: block; color: #f0eee9; font-size: 13px; font-weight: 650; }
.history-sub { display: block; margin-top: 3px; overflow: hidden; color: #858790; font-size: 11px; text-overflow: ellipsis; white-space: nowrap; }

.share-fab {
  position: fixed;
  right: 18px;
  bottom: calc(84px + env(safe-area-inset-bottom));
  z-index: 20;
  width: 46px;
  height: 46px;
  background: #d99b3d;
  border-radius: 50%;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.32);
  color: #17181c;
  font-size: 22px;
  font-weight: 700;
  line-height: 46px;
}

@media (max-width: 340px) {
  .hero-content { padding: 20px 16px; }
  .hero-actions { gap: 7px; }
  .hero-action { width: 96px; }
  .mode-row { flex-wrap: wrap; }
  .mode-wide { flex: 1 1 120px; }
}
