.home-page { padding-top: 12px; }

.hero {
  position: relative;
  height: 224px;
  overflow: hidden;
  background: #23242a;
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 8px;
}

.hero-cover {
  position: absolute;
  width: 100%;
  height: 100%;
}

.hero-shade {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: linear-gradient(90deg, rgba(18, 19, 23, 0.97) 0%, rgba(18, 19, 23, 0.86) 58%, rgba(18, 19, 23, 0.28) 100%);
}

.hero-content {
  position: relative;
  z-index: 1;
  display: flex;
  height: 100%;
  padding: 24px 20px;
  flex-direction: column;
  justify-content: center;
}

.hero-kicker {
  color: #d89b3c;
  font-size: 10px;
  font-weight: 700;
}

.hero-title {
  margin-top: 7px;
  color: #fff;
  font-size: 27px;
  font-weight: 800;
  line-height: 1.25;
}

.hero-sub {
  margin-top: 7px;
  color: #a8a9ae;
  font-size: 13px;
}

.hero-actions { display: flex; gap: 9px; margin-top: 21px; }
.hero-action { width: 104px; min-height: 40px; font-size: 13px; }

.strategy-list { display: flex; flex-direction: column; gap: 12px; }

.strategy-card {
  padding: 14px;
  background: #22242a;
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 8px;
}

.strategy-card:active { background: #272930; }
.strategy-head { display: flex; align-items: center; }

.strategy-cover {
  width: 52px;
  height: 52px;
  flex-shrink: 0;
  margin-right: 12px;
  background: #30323a;
  border-radius: 6px;
}

.strategy-title-wrap { flex: 1; min-width: 0; }
.strategy-title { display: block; color: #f5f3ef; font-size: 16px; font-weight: 700; }
.strategy-sub { display: block; margin-top: 4px; color: #858790; font-size: 12px; }

.mode-groups {
  display: flex;
  margin-top: 14px;
  padding-top: 12px;
  flex-direction: column;
  gap: 8px;
  border-top: 1px solid rgba(255, 255, 255, 0.06);
}

.mode-row { display: flex; gap: 8px; }

.mode-btn {
  min-width: 56px;
  height: 32px;
  padding: 0 12px;
  background: #2d2f36;
  border: 1px solid rgba(255, 255, 255, 0.07);
  border-radius: 5px;
  color: #b9bac0;
  font-size: 12px;
  line-height: 30px;
}

.mode-wide { flex: 1; }
.mode-btn:active, .mode-active { background: #3a3021; border-color: rgba(216, 155, 60, 0.5); color: #efbd6d; }

.history-fab {
  position: fixed;
  right: 18px;
  bottom: calc(146px + env(safe-area-inset-bottom));
  z-index: 30;
  display: flex;
  width: 46px;
  height: 46px;
  align-items: center;
  justify-content: center;
  background: #262930;
  border: 1px solid rgba(216, 155, 60, 0.45);
  border-radius: 50%;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.32);
  color: #efbd6d;
}

.history-fab-icon { font-size: 16px; font-weight: 700; }
.history-fab-badge {
  position: absolute;
  top: -4px;
  right: -4px;
  display: flex;
  min-width: 18px;
  height: 18px;
  padding: 0 4px;
  align-items: center;
  justify-content: center;
  background: #b6655b;
  border-radius: 10px;
  color: #fff;
  font-size: 10px;
  line-height: 18px;
}

.history-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 980;
  background: rgba(0, 0, 0, 0.68);
}

.history-sheet {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 990;
  max-height: 62vh;
  overflow-y: auto;
  padding: 4px 18px calc(28px + env(safe-area-inset-bottom));
  background: #23252b;
  border-top: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 10px 10px 0 0;
  animation: sheet-up 0.2s ease-out;
}

.sheet-handle { width: 34px; height: 3px; margin: 8px auto 15px; background: #555861; border-radius: 2px; }
.history-sheet-head { display: flex; margin-bottom: 14px; align-items: flex-start; justify-content: space-between; }
.history-sheet-kicker { display: block; color: #d8a04a; font-size: 10px; font-weight: 700; }
.history-sheet-title { display: block; margin-top: 4px; color: #f5f3ef; font-size: 18px; font-weight: 750; }
.history-sheet-actions { display: flex; align-items: center; gap: 12px; }
.history-action { color: #d89b3c; font-size: 12px; }
.sheet-close { display: flex; width: 32px; height: 32px; align-items: center; justify-content: center; color: #a5a7ad; font-size: 22px; line-height: 32px; }
.history-sheet-list { display: flex; flex-direction: column; gap: 8px; }
.history-sheet-row {
  display: flex;
  min-height: 58px;
  padding: 10px 12px;
  align-items: center;
  background: #2a2c33;
  border: 1px solid rgba(255, 255, 255, 0.07);
  border-radius: 7px;
}
.history-sheet-row:active { background: #31333b; }
.history-sheet-body { flex: 1; min-width: 0; }
.history-sheet-name { display: block; color: #f0eee9; font-size: 13px; font-weight: 650; }
.history-sheet-sub { display: block; margin-top: 4px; overflow: hidden; color: #858790; font-size: 11px; text-overflow: ellipsis; white-space: nowrap; }

@keyframes sheet-up {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.share-fab {
  position: fixed;
  right: 18px;
  bottom: calc(84px + env(safe-area-inset-bottom));
  z-index: 20;
  width: 46px;
  height: 46px;
  background: #d99b3d;
  border-radius: 50%;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.32);
  color: #17181c;
  font-size: 22px;
  font-weight: 700;
  line-height: 46px;
}

@media (max-width: 340px) {
  .hero-content { padding: 20px 16px; }
  .hero-actions { gap: 7px; }
  .hero-action { width: 96px; }
  .mode-row { flex-wrap: wrap; }
  .mode-wide { flex: 1 1 120px; }
}
