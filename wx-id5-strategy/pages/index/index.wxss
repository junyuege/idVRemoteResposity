.card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20px 16px;
  min-height: 108px;
  margin-bottom: 12px;
  background: #1e1e24;
}

.left-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 0;
}

.map-icon-wrap {
  width: 48px;
  height: 48px;
  border-radius: 50%;
  background: #2a2a33;
  border: 2px solid rgba(255, 156, 0, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 8px;
}

.map-icon-star {
  font-size: 22px;
  color: #ff9c00;
  filter: drop-shadow(0 0 8px rgba(255, 156, 0, 0.5));
}

.map-title {
  font-size: 16px;
  font-weight: 700;
  color: #fff;
  line-height: 1.3;
}

.map-sub {
  font-size: 12px;
  color: #999;
  margin-top: 2px;
}

.right-content {
  display: flex;
  flex-direction: column;
  gap: 8px;
  min-width: 0;
}

.pillar-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.pill {
  flex: 1 1 auto;
  min-width: 0;
  padding: 7px 12px;
  border-radius: 999px;
  font-size: 12px;
  font-weight: 600;
  color: #ccc;
  background: #2a2a33;
  border: 1px solid rgba(255, 255, 255, 0.06);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  text-align: center;
}

.pill.active {
  background: #ff9c00;
  color: #121214;
  font-weight: 700;
  border-color: #ff9c00;
}