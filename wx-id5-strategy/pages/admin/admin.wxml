<view class="page-wrap admin-page">
  <view class="page-header">
    <text class="header-kicker">ADMIN</text>
    <view class="header-title">管理台</view>
    <text class="header-sub">反馈处理与匿名统计</text>
  </view>

  <view wx:if="{{loading}}" class="loading-wrap">
    <view class="loading-dot"></view>
    <text>正在识别管理员...</text>
  </view>

  <view wx:elif="{{error}}" class="empty-wrap">
    <text>{{error}}</text>
    <button class="retry-btn" bindtap="retry">重新加载</button>
  </view>

  <view wx:elif="{{!isAdmin}}" class="empty-wrap">
    <text>当前账号不是管理员</text>
    <text class="admin-openid">当前 openid：{{openid}}</text>
    <view class="bind-box">
      <input
        class="bind-input"
        value="{{bindCode}}"
        placeholder="请输入管理员绑定码"
        placeholder-class="bind-placeholder"
        bindinput="onBindInput"
      />
      <button class="bind-btn" bindtap="bindAdmin" disabled="{{binding}}">{{binding ? '绑定中...' : '绑定管理员'}}</button>
    </view>
    <text class="admin-tip">绑定成功后自动进入管理台，无需修改云函数代码</text>
  </view>

  <block wx:else>
    <view class="admin-tabs">
      <view class="admin-tab {{activeTab === 'feedback' ? 'admin-tab-active' : ''}}" data-tab="feedback" bindtap="onTabTap">反馈</view>
      <view class="admin-tab {{activeTab === 'stats' ? 'admin-tab-active' : ''}}" data-tab="stats" bindtap="onTabTap">统计</view>
      <view class="admin-tab {{activeTab === 'announcement' ? 'admin-tab-active' : ''}}" data-tab="announcement" bindtap="onTabTap">公告</view>
    </view>

    <view wx:if="{{activeTab === 'feedback'}}" class="admin-list">
      <view wx:if="{{!feedback.length}}" class="empty-wrap compact-empty"><text>暂无反馈</text></view>
      <view wx:for="{{feedback}}" wx:key="id" class="admin-card">
        <view class="admin-card-head">
          <text class="tag {{item.statusClass}}">{{item.statusText}}</text>
          <text class="admin-time">{{item.time}}</text>
        </view>
        <text class="admin-content">{{item.content}}</text>
        <view wx:if="{{item.processedTime}}" class="admin-processed">最近处理：{{item.processedTime}}</view>
        <view class="admin-meta-row">
          <button wx:if="{{item.imageCount}}" class="admin-action" data-index="{{index}}" bindtap="previewFeedbackImages">预览截图 {{item.imageCount}}</button>
          <text wx:else class="admin-meta">无截图</text>
          <view class="admin-actions">
            <button class="admin-action" data-id="{{item.id}}" data-status="processing" bindtap="onFeedbackStatusTap">处理中</button>
            <button class="admin-action" data-id="{{item.id}}" data-status="resolved" bindtap="onFeedbackStatusTap">已解决</button>
          </view>
        </view>
      </view>
      <view wx:if="{{hasMore}}" class="load-more-row">
        <button class="load-more-btn" bindtap="loadMoreFeedback" disabled="{{loadingMore}}">{{loadingMore ? '加载中...' : '加载更多'}}</button>
      </view>
    </view>

    <view wx:elif="{{activeTab === 'stats'}}" class="admin-list">
      <view wx:if="{{!stats.totals.length && !stats.dailyTrend.length}}" class="empty-wrap compact-empty"><text>暂无统计</text></view>

      <view class="admin-section-title">事件汇总</view>
      <view wx:for="{{stats.totals}}" wx:key="label" class="admin-stat-card">
        <text class="admin-stat-label">{{item.label}}</text>
        <text class="admin-stat-count">{{item.count}}</text>
      </view>

      <view wx:if="{{stats.dailyTrend.length}}" class="admin-section-title">近 14 天趋势</view>
      <view class="trend-list">
        <view wx:for="{{stats.dailyTrend}}" wx:key="day" class="trend-row">
          <text class="trend-day">{{item.day}}</text>
          <view class="trend-bar-wrap"><view class="trend-bar" style="width: {{item.percent}}%;"></view></view>
          <text class="trend-count">{{item.count}}</text>
        </view>
      </view>

      <view wx:if="{{stats.topRoutes.length}}" class="admin-section-title">热门路线</view>
      <view wx:for="{{stats.topRoutes}}" wx:key="routeId" class="top-row">
        <text class="top-name">{{item.routeId}}</text>
        <text class="top-count">{{item.count}}</text>
      </view>

      <view wx:if="{{stats.topFailedImages.length}}" class="admin-section-title">失败图片 Top</view>
      <view wx:for="{{stats.topFailedImages}}" wx:key="src" class="top-row">
        <text class="top-name top-name-small">{{item.src}}</text>
        <text class="top-count">{{item.count}}</text>
      </view>
    </view>

    <view wx:elif="{{activeTab === 'announcement'}}" class="admin-list">
      <view class="ann-form">
        <view class="ann-form-title">{{annEditing ? '编辑公告' : '新建公告'}}</view>
        <input
          class="ann-input"
          value="{{annTitle}}"
          maxlength="30"
          placeholder="公告标题（30 字以内）"
          placeholder-class="bind-placeholder"
          bindinput="onAnnTitleInput"
        />
        <textarea
          class="ann-textarea"
          value="{{annContent}}"
          maxlength="500"
          placeholder="公告内容（500 字以内，支持换行）"
          placeholder-class="bind-placeholder"
          bindinput="onAnnContentInput"
        />
        <view class="ann-form-actions">
          <button wx:if="{{annEditing}}" class="admin-action" bindtap="onAnnCancel">取消编辑</button>
          <button class="ann-save-btn" bindtap="saveAnnouncement" disabled="{{annSaving}}">{{annSaving ? '保存中...' : (annEditing ? '保存修改' : '发布公告')}}</button>
        </view>
      </view>

      <view class="admin-section-title">公告列表（同一时间仅一条上线）</view>
      <view wx:if="{{!announcements.length && !annLoading}}" class="empty-wrap compact-empty"><text>暂无公告</text></view>
      <view wx:if="{{annLoading && !announcements.length}}" class="empty-wrap compact-empty"><text>加载中...</text></view>
      <view wx:for="{{announcements}}" wx:key="id" class="admin-card">
        <view class="admin-card-head">
          <text class="tag {{item.active ? 'tag-easy' : 'tag-normal'}}">{{item.active ? '上线中' : '已下线'}}</text>
          <text class="admin-time">{{item.time}}</text>
        </view>
        <text class="admin-content">{{item.title}}</text>
        <text class="ann-list-content">{{item.content}}</text>
        <view class="admin-meta-row">
          <view class="admin-actions">
            <button
              class="admin-action"
              data-id="{{item.id}}"
              data-active="{{item.active ? '1' : '0'}}"
              bindtap="toggleAnnouncement"
            >{{item.active ? '下线' : '上线'}}</button>
            <button class="admin-action" data-id="{{item.id}}" bindtap="onAnnEdit">编辑</button>
            <button class="admin-action ann-danger" data-id="{{item.id}}" bindtap="deleteAnnouncement">删除</button>
          </view>
        </view>
      </view>
    </view>
  </block>
</view>
