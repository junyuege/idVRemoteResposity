<view class="page-wrap detail-page">
  <view wx:if="{{loading}}" class="loading-wrap">
    <view class="loading-dot"></view>
    <text>正在加载攻略图片...</text>
  </view>

  <view wx:elif="{{error}}" class="empty-wrap">
    <text>{{error}}</text>
    <button class="retry-btn" bindtap="onRetry">重新加载</button>
  </view>

  <view wx:elif="{{strategy}}">
    <view class="detail-header">
      <text class="header-kicker">{{strategy.mapName}}</text>
      <view class="detail-title">{{strategy.title}}</view>
      <view class="detail-tags">
        <text class="tag {{strategy.difficultyTagClass}}">{{strategy.difficultyTag}}</text>
        <text class="detail-author">攻略：{{strategy.author}}</text>
      </view>
    </view>

    <view class="summary-bar">
      <text>{{strategy.summary}}</text>
    </view>

    <view class="detail-copy">
      <text>{{strategy.content}}</text>
    </view>

    <view class="section-title-row image-heading">
      <text class="section-title">路线图</text>
      <text class="section-meta">{{strategy.images.length}} 张</text>
    </view>

    <view wx:if="{{strategy.imageItems.length}}" class="image-list">
      <view wx:for="{{strategy.imageItems}}" wx:key="url" class="image-item">
        <view class="image-index">{{item.index}}</view>
        <image
          wx:if="{{!item.failed}}"
          class="strategy-image"
          src="{{item.url}}"
          data-src="{{item.url}}"
          data-index="{{index}}"
          mode="widthFix"
          lazy-load="true"
          show-menu-by-longpress="true"
          bindtap="previewImage"
          binderror="onImageError"
        />
        <button wx:else class="image-failed" data-index="{{index}}" bindtap="onImageRetry">
          <text class="image-failed-title">图片加载失败</text>
          <text class="image-retry">点击重试</text>
        </button>
      </view>
    </view>

    <view wx:else class="empty-wrap compact-empty"><text>当前入口暂无图片</text></view>
  </view>

  <view wx:else class="empty-wrap"><text>攻略不存在</text></view>
</view>
