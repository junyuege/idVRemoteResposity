.page-wrap { padding: 16px 18px 30px; }
.page-header { margin-bottom: 16px; }
.header-title {
  font-size: 20px;
  font-weight: 700;
  color: #ff9c00;
  line-height: 1.3;
}
.header-sub {
  font-size: 13px;
  color: #888;
  margin-top: 4px;
}
.loading-wrap { padding: 50px 0; text-align: center; color: #aaa; font-size: 13px; }
.img-wrap {
  background: #2a2b32;
  border: 1px solid rgba(255, 255, 255, 0.06);
  border-radius: 10px;
  overflow: hidden;
}
.tutorial-img {
  width: 100%;
  display: block;
  background: #333;
}
