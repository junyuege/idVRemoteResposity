.tutorial-page { padding-top: 16px; }

.tutorial-frame {
  overflow: hidden;
  background: #22242a;
  border: 1px solid rgba(255, 255, 255, 0.09);
  border-radius: 7px;
}

.tutorial-frame:active { border-color: rgba(216, 155, 60, 0.36); }
.tutorial-img { display: block; width: 100%; min-height: 200px; background: #fff; }

.image-footer {
  display: flex;
  height: 48px;
  padding: 0 13px;
  align-items: center;
  justify-content: space-between;
  color: #d9d6d1;
  font-size: 13px;
}

.image-action { color: #dda34a; font-size: 12px; }
