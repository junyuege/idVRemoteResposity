.page-wrap { padding: 16px 18px; }
.page-header { margin-bottom: 20px; }
.header-title {
  font-size: 20px;
  font-weight: 700;
  color: #ff9c00;
  line-height: 1.3;
}
.header-sub {
  font-size: 13px;
  color: #888;
  margin-top: 4px;
}
.loading-wrap, .empty-wrap {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  gap: 10px;
  min-height: 200px;
}

.version-card {
  display: flex;
  align-items: center;
  padding: 16px 14px;
}
.version-icon-wrap {
  width: 46px;
  height: 46px;
  border-radius: 10px;
  background: rgba(255, 156, 0, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 12px;
  flex-shrink: 0;
}
.version-icon { font-size: 22px; }
.version-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4px;
}
.version-line {
  display: flex;
  align-items: center;
  gap: 6px;
}
.version-name {
  font-size: 15px;
  font-weight: 600;
  color: #fff;
}
.version-tag {
  flex-shrink: 0;
  margin: 0;
  background: #3d2a2a;
  color: #f07a5a;
}
.version-folder {
  font-size: 11px;
  color: #777;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.version-desc {
  font-size: 12px;
  color: #999;
}
.version-arrow {
  font-size: 24px;
  color: #ff9c00;
  margin-left: 10px;
}
