<view class="page-wrap">
  <view class="page-header">
    <view class="header-title">{{mapName}} · 难度版本</view>
    <view class="header-sub">选择版本进入对应巡图</view>
  </view>

  <view wx:if="{{loading}}" class="loading-wrap"><text>加载中...</text></view>

  <view wx:elif="{{error}}" class="empty-wrap">
    <text>{{error}}</text>
    <view bindtap="onRetry" style="margin-top:14px;padding:8px 26px;background:rgba(255,156,0,0.12);border:1px solid rgba(255,156,0,0.4);border-radius:20px;color:#ff9c00;font-size:13px;">重新加载</view>
  </view>

  <view wx:elif="{{versions.length === 0}}" class="empty-wrap">
    <text>暂无难度版本数据</text>
  </view>

  <view wx:else class="version-list">
    <view
      class="version-card panel"
      wx:for="{{versions}}"
      wx:key="id"
      data-index="{{index}}"
      bindtap="onVersionTap"
    >
      <view class="version-icon-wrap">
        <text class="version-icon">🗺️</text>
      </view>
      <view class="version-body">
        <view class="version-line">
          <text class="version-name">{{item.name}}</text>
          <text class="tag version-tag">{{item.label}}</text>
        </view>
        <text class="version-folder">{{item.folder}}</text>
        <text class="version-desc">{{item.desc}}</text>
      </view>
      <text class="version-arrow">›</text>
    </view>
  </view>
</view>
