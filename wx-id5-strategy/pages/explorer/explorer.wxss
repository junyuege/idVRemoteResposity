.explorer-page { padding-top: 14px; }
.explorer-header { margin-bottom: 16px; }

.author-picker {
  display: grid;
  margin-bottom: 10px;
  padding: 3px;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 3px;
  background: #22242a;
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 7px;
}

.author-option {
  min-width: 0;
  height: 36px;
  overflow: hidden;
  border-radius: 5px;
  color: #92949b;
  font-size: 12px;
  line-height: 36px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.author-option-active { background: #353129; color: #efbd6d; font-weight: 650; }

.route-picker-wrap {
  padding: 13px;
  background: #22242a;
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 8px;
}

.picker-head { display: flex; margin-bottom: 11px; align-items: baseline; justify-content: space-between; gap: 12px; }
.picker-label { flex-shrink: 0; color: #ddd9d3; font-size: 13px; font-weight: 650; }
.picker-current { min-width: 0; overflow: hidden; color: #858790; font-size: 11px; text-overflow: ellipsis; white-space: nowrap; }
.route-picker { width: 100%; white-space: nowrap; }
.route-picker-inner { display: inline-flex; gap: 8px; }

.route-option {
  height: 34px;
  padding: 0 13px;
  background: #2d2f36;
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 5px;
  color: #b0b2b8;
  font-size: 12px;
  line-height: 32px;
}

.route-option-active { background: #3a3021; border-color: rgba(216, 155, 60, 0.5); color: #efbd6d; font-weight: 650; }
.shape-heading { margin-top: 21px; }
.shape-list { display: flex; flex-direction: column; gap: 9px; }
.shape-card { min-height: 78px; }

.shape-mark {
  display: flex;
  width: 47px;
  height: 47px;
  margin-right: 13px;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  background: #2d2f36;
  border: 1px solid rgba(216, 155, 60, 0.25);
  border-radius: 6px;
  color: #e5aa4c;
  font-size: 19px;
  font-weight: 800;
}

.shape-body { min-width: 0; flex: 1; }
.shape-title { display: block; overflow: hidden; color: #f3f1ed; font-size: 14px; font-weight: 650; text-overflow: ellipsis; white-space: nowrap; }
.shape-desc { display: block; margin-top: 5px; color: #878991; font-size: 12px; }
.compact-empty { min-height: 150px; }

.sheet-mask { position: fixed; top: 0; right: 0; bottom: 0; left: 0; z-index: 980; background: rgba(0, 0, 0, 0.72); }

.door-sheet {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 990;
  max-height: 74vh;
  overflow-y: auto;
  padding: 4px 16px calc(22px + env(safe-area-inset-bottom));
  background: #23252b;
  border-top: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 8px 8px 0 0;
  animation: sheet-up 0.2s ease-out;
}

.sheet-handle { width: 34px; height: 3px; margin: 8px auto 15px; background: #555861; border-radius: 2px; }
.sheet-head { display: flex; margin-bottom: 14px; align-items: center; justify-content: space-between; }
.sheet-kicker { display: block; color: #d8a04a; font-size: 11px; font-weight: 700; }
.sheet-title { display: block; margin-top: 4px; color: #f5f3ef; font-size: 18px; font-weight: 750; }
.sheet-close { display: flex; width: 40px; height: 40px; flex-shrink: 0; align-items: center; justify-content: center; color: #a5a7ad; font-size: 25px; line-height: 40px; }
.door-list { display: flex; flex-direction: column; gap: 8px; }

.door-option {
  display: flex;
  min-height: 68px;
  padding: 11px 12px;
  align-items: center;
  background: #2a2c33;
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 7px;
}

.door-option:active { background: #31333b; }
.door-mark { display: flex; width: 40px; height: 40px; margin-right: 11px; flex-shrink: 0; align-items: center; justify-content: center; background: #26353d; border-radius: 6px; color: #83b5d4; font-size: 13px; font-weight: 800; }
.door-icon { width: 40px; height: 40px; margin-right: 11px; flex-shrink: 0; object-fit: cover; background: #1b1d22; border-radius: 6px; }
.door-body { display: flex; min-width: 0; flex: 1; flex-direction: column; gap: 4px; }
.door-name { color: #f3f1ed; font-size: 14px; font-weight: 650; }
.door-desc { color: #858790; font-size: 11px; }

@keyframes sheet-up {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}
