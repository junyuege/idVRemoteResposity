<view class="page-wrap explorer-page">
  <view class="page-header explorer-header">
    <text class="header-kicker">{{mapName}} · {{authorName}}</text>
    <view class="header-title">路线查询</view>
    <text class="header-sub">选择版本和路线形状，入口在当前页展开</text>
  </view>

  <view wx:if="{{loading}}" class="loading-wrap">
    <view class="loading-dot"></view>
    <text>正在整理路线...</text>
  </view>

  <view wx:elif="{{error}}" class="empty-wrap">
    <text>{{error}}</text>
    <button class="retry-btn" bindtap="onRetry">重新加载</button>
  </view>

  <block wx:else>
    <view wx:if="{{authors.length > 1}}" class="author-picker" aria-label="攻略作者">
      <button
        wx:for="{{authors}}"
        wx:key="id"
        class="author-option {{authorId === item.id ? 'author-option-active' : ''}}"
        data-authorid="{{item.id}}"
        bindtap="onAuthorChange"
      >{{item.name}}</button>
    </view>

    <view class="route-picker-wrap">
      <view class="picker-head">
        <text class="picker-label">难度版本</text>
        <text class="picker-current">{{routeName}}</text>
      </view>
      <scroll-view class="route-picker" scroll-x="true" enhanced="true" show-scrollbar="false">
        <view class="route-picker-inner">
          <button
            wx:for="{{routes}}"
            wx:key="id"
            class="route-option {{routeId === item.id ? 'route-option-active' : ''}}"
            data-routeid="{{item.id}}"
            bindtap="onRouteChange"
          >{{item.label}}</button>
        </view>
      </scroll-view>
    </view>

    <view class="shape-search">
      <text class="search-icon">⌕</text>
      <input
        class="shape-search-input"
        value="{{keyword}}"
        placeholder="搜索形状或侧门入口"
        placeholder-class="shape-search-placeholder"
        bindinput="onSearchInput"
      />
      <text wx:if="{{keyword}}" class="search-clear" bindtap="clearSearch">×</text>
    </view>

    <view class="section-title-row shape-heading">
      <text class="section-title">路线形状</text>
      <text class="section-meta">{{displayShapes.length}} / {{shapes.length}} 种</text>
    </view>

    <view wx:if="{{displayShapes.length}}" class="shape-list">
      <view
        wx:for="{{displayShapes}}"
        wx:key="id"
        class="list-card shape-card"
        data-index="{{index}}"
        bindtap="onShapeTap"
      >
        <view class="shape-mark">{{item.shape}}</view>
        <view class="shape-body">
          <text class="shape-title">{{item.title}}</text>
          <text class="shape-desc">{{item.desc}}</text>
        </view>
        <text class="list-arrow">›</text>
      </view>
    </view>

    <view wx:elif="{{keyword}}" class="empty-wrap compact-empty"><text>没有匹配的形状或入口</text></view>
    <view wx:else class="empty-wrap compact-empty"><text>该版本暂无路线数据</text></view>
  </block>

  <view wx:if="{{showDoorSheet}}" class="sheet-mask" bindtap="closeDoorSheet"></view>
  <view wx:if="{{showDoorSheet}}" class="door-sheet" catchtap="preventClose">
    <view class="sheet-handle"></view>
    <view class="sheet-head">
      <view>
        <text class="sheet-kicker">{{selectedShape.shape}} 型路线</text>
        <text class="sheet-title">选择侧门入口</text>
      </view>
      <button class="sheet-close" bindtap="closeDoorSheet" aria-label="关闭">×</button>
    </view>
    <text wx:if="{{hasIcon}}" class="sheet-hint">可长按图标放大查看</text>
    <view class="door-list">
      <view wx:for="{{doors}}" wx:key="door" class="door-option" data-index="{{index}}" bindtap="onDoorTap" bindlongpress="onIconLongPress" data-icon="{{item.icon}}">
        <image wx:if="{{item.icon}}" class="door-icon" src="{{item.icon}}" mode="aspectFill" data-index="{{index}}" binderror="onIconError" />
        <view wx:else class="door-mark">{{item.mark}}</view>
        <view class="door-body">
          <text class="door-name">{{item.door}}</text>
          <text class="door-desc">{{item.desc}}</text>
        </view>
        <text class="list-arrow">›</text>
      </view>
    </view>
  </view>

  <view wx:if="{{showIconPreview}}" class="preview-mask" bindtap="closeIconPreview">
    <view class="preview-body" catchtap="preventPreviewClose">
      <image class="preview-img" src="{{previewIcon}}" mode="widthFix" binderror="onIconPreviewError" />
      <text class="preview-hint">轻触空白处关闭</text>
    </view>
  </view>
</view>
