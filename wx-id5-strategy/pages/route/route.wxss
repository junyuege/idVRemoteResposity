.page-wrap { padding: 16px 18px; }
.page-header { margin-bottom: 20px; }
.header-title {
  font-size: 20px;
  font-weight: 700;
  color: #ff9c00;
  line-height: 1.3;
}
.header-sub {
  font-size: 13px;
  color: #888;
  margin-top: 4px;
}
.loading-wrap, .empty-wrap {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  gap: 10px;
  min-height: 200px;
  color: #888;
  font-size: 14px;
}
.route-grid {
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.route-card {
  background: #1e1e24;
  border-radius: 14px;
  padding: 16px 18px;
  display: flex;
  align-items: center;
  gap: 14px;
  border: 1px solid rgba(255,255,255,0.04);
  position: relative;
  overflow: hidden;
}
.route-card:active {
  opacity: 0.7;
  background: #26262e;
}
.route-shape-wrap {
  width: 52px;
  height: 52px;
  border-radius: 12px;
  background: #2a2a33;
  border: 1px solid rgba(255,156,0,0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.route-shape {
  font-size: 22px;
  color: #ff9c00;
  font-weight: 700;
  line-height: 1;
}
.route-info {
  flex: 1;
  min-width: 0;
}
.route-title {
  font-size: 15px;
  font-weight: 600;
  color: #fff;
  display: block;
  margin-bottom: 3px;
}
.route-desc {
  font-size: 12px;
  color: #888;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.route-arrow {
  font-size: 20px;
  color: #555;
  flex-shrink: 0;
  padding-left: 4px;
}
