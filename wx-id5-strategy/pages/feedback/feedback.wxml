<view class="page-wrap feedback-page">
  <view class="page-header">
    <text class="header-kicker">FEEDBACK</text>
    <view class="header-title">意见反馈</view>
    <text class="header-sub">问题描述越具体，越容易定位处理</text>
  </view>

  <view class="field-head">
    <text class="field-label">反馈内容</text>
    <text class="field-count">{{contentLength}} / 500</text>
  </view>
  <textarea
    class="feedback-input"
    value="{{content}}"
    bindinput="onContentInput"
    placeholder="请描述出现问题的页面、操作和结果"
    placeholder-class="feedback-placeholder"
    maxlength="500"
    disabled="{{submitting}}"
  />

  <view class="field-head image-field-head">
    <view>
      <text class="field-label">相关截图</text>
      <text class="field-optional">选填，最多 8 张</text>
    </view>
    <text class="field-count">{{images.length}} / 8</text>
  </view>
  <view class="upload-grid">
    <view wx:for="{{images}}" wx:key="this" class="upload-item">
      <image src="{{item}}" mode="aspectFill" class="upload-image" />
      <button data-index="{{index}}" bindtap="removeImage" class="remove-image" aria-label="移除截图">×</button>
    </view>
    <button wx:if="{{images.length < 8}}" bindtap="chooseImage" class="add-image" disabled="{{submitting}}">
      <text class="add-symbol">＋</text>
      <text class="add-label">添加截图</text>
    </button>
  </view>

  <button class="submit-btn {{submitting ? 'submit-disabled' : ''}}" bindtap="submitFeedback" disabled="{{submitting}}">
    {{submitting ? '正在提交...' : '提交反馈'}}
  </button>
  <text class="draft-note">提交失败时，文字与截图路径会暂存为本地草稿</text>
</view>
