<view class="page-wrap">
  <view style="font-size:20px;font-weight:700;color:#ff9c00;margin:6px 0 18px;">意见反馈</view>
  <textarea value="{{content}}" bindinput="onContentInput" placeholder="请描述你的问题或建议（最多500字）" maxlength="500" style="width:100%;min-height:160px;padding:14px;background:#2a2b32;border:1px solid #4a4a52;border-radius:8px;color:#fff;font-size:14px;" />
  <view style="text-align:right;font-size:12px;color:#888;margin-top:6px;">{{contentLength}}/500</view>
  <view style="margin-top:20px;">
    <view style="font-size:14px;color:#ccc;margin-bottom:10px;">上传截图（选填，最多8张）</view>
    <view style="display:flex;flex-wrap:wrap;gap:10px;">
      <view wx:for="{{images}}" wx:key="this" style="width:80px;height:80px;border-radius:6px;overflow:hidden;background:#333;">
        <image src="{{item}}" mode="aspectFill" style="width:100%;height:100%;" />
      </view>
      <view wx:if="{{images.length < 8}}" bindtap="chooseImage" style="width:80px;height:80px;border-radius:6px;border:2px dashed #555;display:flex;align-items:center;justify-content:center;font-size:28px;color:#888;">+</view>
    </view>
  </view>
  <button bindtap="submitFeedback" style="width:100%;margin-top:30px;padding:14px;background:#ff9c00;color:#1c1d22;font-size:16px;font-weight:600;border-radius:8px;text-align:center;">提交反馈</button>
</view>