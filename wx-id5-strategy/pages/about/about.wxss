.about-page { padding-top: 20px; }

.about-brand {
  display: flex;
  padding: 24px 18px;
  flex-direction: column;
  align-items: center;
  background: #22242a;
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 8px;
}

.about-mark {
  display: flex;
  width: 58px;
  height: 58px;
  align-items: center;
  justify-content: center;
  background: #3a3021;
  border: 1px solid rgba(216, 155, 60, 0.35);
  border-radius: 8px;
  color: #ebb35b;
  font-size: 22px;
  font-weight: 800;
}

.about-title { margin-top: 13px; color: #f5f3ef; font-size: 18px; font-weight: 750; }
.about-version { margin-top: 5px; color: #7f8189; font-size: 11px; }

.about-section {
  margin-top: 12px;
  padding: 16px;
  background: #22242a;
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 7px;
}

.about-heading { display: block; margin-bottom: 8px; color: #e3aa50; font-size: 13px; font-weight: 700; }
.about-copy { display: block; color: #b1b2b7; font-size: 13px; line-height: 1.8; }
.about-footer { display: block; margin-top: 22px; color: #60626a; font-size: 10px; text-align: center; }
