.page-wrap { padding: 16px 18px 30px; }

.profile {
  display: flex;
  align-items: center;
  padding: 20px 16px;
  margin-bottom: 14px;
}
.avatar {
  width: 52px;
  height: 52px;
  border-radius: 12px;
  background: rgba(255, 156, 0, 0.14);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26px;
  margin-right: 14px;
  flex-shrink: 0;
}
.profile-body { flex: 1; min-width: 0; }
.profile-title {
  font-size: 16px;
  font-weight: 700;
  color: #fff;
}
.profile-sub {
  font-size: 12px;
  color: #999;
  margin-top: 5px;
}

.menu { padding: 0 14px; }
.menu-item {
  display: flex;
  align-items: center;
  padding: 15px 0;
}
.menu-icon {
  font-size: 18px;
  margin-right: 12px;
}
.menu-label {
  flex: 1;
  font-size: 14px;
  color: #fff;
}
.menu-arrow {
  font-size: 22px;
  color: #ff9c00;
}
.menu-divider {
  height: 1px;
  background: rgba(255, 255, 255, 0.05);
}

.share-btn {
  margin-top: 22px;
  height: 46px;
  line-height: 46px;
  border-radius: 10px;
  background: linear-gradient(135deg, #ff9c00, #ff7a00);
  color: #fff;
  font-size: 15px;
  font-weight: 600;
  text-align: center;
}

.footer {
  margin-top: 24px;
  text-align: center;
  font-size: 11px;
  color: #666;
}