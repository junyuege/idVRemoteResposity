.inventory-page { padding-top: 14px; }
.inventory-head { display: flex; margin: 2px 2px 16px; align-items: flex-end; justify-content: space-between; }
.inventory-title { display: block; color: #f6f4f0; font-size: 21px; font-weight: 750; }
.inventory-sub { display: block; margin-top: 4px; color: #858790; font-size: 12px; }
.inventory-count { color: #8b8d94; font-size: 12px; }

.seg-wrap {
  display: flex;
  margin-bottom: 14px;
  padding: 3px;
  background: #22242a;
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 7px;
}

.seg-item { display: flex; height: 34px; flex: 1; align-items: center; justify-content: center; border-radius: 5px; color: #8f9199; font-size: 13px; }
.seg-active { background: #3a3021; color: #edb65f; font-weight: 650; }

.filter-scroll { margin-bottom: 14px; white-space: nowrap; }
.filter-row { display: inline-flex; gap: 8px; padding: 1px; }
.filter-chip {
  display: inline-flex;
  height: 30px;
  padding: 0 12px;
  align-items: center;
  justify-content: center;
  background: #25272d;
  border: 1px solid rgba(255, 255, 255, 0.07);
  border-radius: 15px;
  color: #9b9da5;
  font-size: 12px;
  line-height: 30px;
}
.filter-active { background: #3a3021; border-color: rgba(216, 155, 60, 0.45); color: #efbd6d; }

.inventory-list { display: flex; flex-direction: column; gap: 9px; }

.inventory-card {
  display: flex;
  min-height: 100px;
  padding: 11px;
  align-items: center;
  background: #22242a;
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-left-width: 3px;
  border-radius: 7px;
}

.inventory-card:active { background: #292b32; }
.card-rarity-common { border-left-color: #577fa8; }
.card-rarity-rare { border-left-color: #8f67a8; }
.card-rarity-epic { border-left-color: #ad5e59; }
.card-rarity-legendary { border-left-color: #c2924f; }
.card-rarity-none { border-left-color: #5d6069; }

.card-icon { width: 66px; height: 66px; margin-right: 12px; flex-shrink: 0; background: #30323a; border-radius: 6px; }
.card-body { display: flex; min-width: 0; flex: 1; flex-direction: column; }
.card-line { display: flex; align-items: center; gap: 7px; }
.card-name { min-width: 0; flex: 1; overflow: hidden; color: #f5f3ef; font-size: 14px; font-weight: 650; text-overflow: ellipsis; white-space: nowrap; }
.card-badge { flex-shrink: 0; }
.card-desc { display: -webkit-box; margin-top: 5px; overflow: hidden; color: #999ba2; font-size: 12px; line-height: 1.45; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.card-meta { margin-top: 7px; color: #d1a45e; font-size: 11px; }

.mask { position: fixed; top: 0; right: 0; bottom: 0; left: 0; z-index: 980; background: rgba(0, 0, 0, 0.7); animation: fade-in 0.18s; }
.sheet { position: fixed; right: 0; bottom: 0; left: 0; z-index: 990; max-height: 78vh; overflow-y: auto; padding: 4px 18px calc(24px + env(safe-area-inset-bottom)); background: #23252b; border-top: 1px solid rgba(255, 255, 255, 0.1); border-radius: 8px 8px 0 0; animation: slide-up 0.22s ease-out; }
.sheet-handle { width: 34px; height: 3px; margin: 9px auto 15px; background: #555861; border-radius: 2px; }
.sheet-close { position: absolute; top: 14px; right: 14px; display: flex; width: 38px; height: 38px; align-items: center; justify-content: center; color: #a4a6ad; font-size: 25px; line-height: 38px; }
.sheet-icon { display: block; width: 94px; height: 94px; background: #30323a; border-radius: 7px; }
.sheet-title-row { display: flex; margin-top: 14px; align-items: center; flex-wrap: wrap; gap: 6px; }
.sheet-name { margin-right: 4px; color: #f7f5f1; font-size: 18px; font-weight: 750; }
.sheet-desc { display: block; margin-top: 12px; color: #b0b1b6; font-size: 13px; line-height: 1.75; }
.sheet-meta { margin-top: 16px; border-top: 1px solid rgba(255, 255, 255, 0.08); }
.sheet-meta-row { display: flex; padding: 12px 0; gap: 16px; border-bottom: 1px solid rgba(255, 255, 255, 0.06); }
.sheet-meta-label { width: 68px; flex-shrink: 0; color: #858790; font-size: 12px; }
.sheet-meta-value { flex: 1; color: #e2dfda; font-size: 13px; line-height: 1.55; }

@keyframes slide-up { from { transform: translateY(100%); } to { transform: translateY(0); } }
@keyframes fade-in { from { opacity: 0; } to { opacity: 1; } }
