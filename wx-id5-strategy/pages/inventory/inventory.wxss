/* ===== 分段器 ===== */
.seg-wrap {
  display: flex;
  background: #2a2b32;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  border-radius: 8px;
  padding: 3px;
  margin-bottom: 16px;
}
.seg-item {
  flex: 1;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #999;
  font-size: 13px;
  border-radius: 6px;
}
.seg-active {
  background: linear-gradient(135deg, #ff9c00, #ff7a00);
  color: #fff;
  font-weight: 600;
}

/* ===== 卡片两列宫格 ===== */
.grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12px;
}
.card {
  background: #2a2b32;
  border-radius: 12rpx;
  padding: 12px;
  display: flex;
  overflow: hidden;
}
.card-rarity-common { border: 1rpx solid rgba(74, 126, 216, 0.55); }
.card-rarity-rare { border: 1rpx solid rgba(160, 90, 216, 0.55); }
.card-rarity-epic { border: 1rpx solid rgba(224, 85, 85, 0.6); }
.card-rarity-legendary { border: 1rpx solid rgba(240, 176, 74, 0.6); }
.card-rarity-none { border: 1rpx solid rgba(255, 255, 255, 0.14); }

.card-icon {
  width: 100rpx;
  height: 100rpx;
  border-radius: 8rpx;
  background: #333;
  flex-shrink: 0;
  margin-right: 10px;
}
.card-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}
.card-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 4px;
}
.card-name {
  flex: 1;
  min-width: 0;
  font-size: 14px;
  font-weight: 600;
  color: #fff;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.card-badge {
  flex-shrink: 0;
  margin: 0;
}
.card-desc {
  margin-top: 6px;
  font-size: 12px;
  color: #aaa;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
.card-meta {
  margin-top: auto;
  padding-top: 6px;
  font-size: 11px;
  color: #999;
}

/* ===== 底部详情抽屉 ===== */
.mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.65);
  z-index: 980;
  animation: fade-in 0.2s;
}
.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 990;
  background: #22232a;
  border-top-left-radius: 20rpx;
  border-top-right-radius: 20rpx;
  padding: 4rpx 16px 24px;
  padding-bottom: calc(env(safe-area-inset-bottom) + 24px);
  max-height: 75vh;
  overflow-y: auto;
  animation: slide-up 0.25s ease-out;
}
.sheet-handle {
  width: 72rpx;
  height: 6rpx;
  background: #4a4a52;
  border-radius: 3rpx;
  margin: 8rpx auto 16rpx;
}
.sheet-close {
  position: absolute;
  right: 18rpx;
  top: 22rpx;
  width: 56rpx;
  height: 56rpx;
  color: #aaa;
  font-size: 28px;
  display: flex;
  align-items: center;
  justify-content: center;
}
.sheet-icon {
  width: 180rpx;
  height: 180rpx;
  border-radius: 12rpx;
  background: #333;
  display: block;
}
.sheet-title-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 14rpx;
}
.sheet-name {
  font-size: 18px;
  font-weight: 700;
  color: #fff;
  margin-right: 8rpx;
}
.sheet-desc {
  margin-top: 12rpx;
  font-size: 13px;
  color: #aaa;
  line-height: 1.7;
}
.sheet-meta {
  margin-top: 16rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.08);
}
.sheet-meta-row {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  padding: 12rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
}
.sheet-meta-label { font-size: 12px; color: #888; }
.sheet-meta-value { font-size: 13px; color: #eee; line-height: 1.6; }

@keyframes slide-up {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}
@keyframes fade-in {
  from { opacity: 0; }
  to { opacity: 1; }
}