<view class="page-wrap inventory-page">
  <view class="inventory-head">
    <view>
      <text class="inventory-title">资料图鉴</text>
      <text class="inventory-sub">异象、道具与辞章</text>
    </view>
    <text class="inventory-count">{{items.length}} 项</text>
  </view>

  <view class="search-box">
    <text class="search-icon">⌕</text>
    <input value="{{keyword}}" class="search-input" placeholder="搜索名称、效果或品质" placeholder-class="search-placeholder" bindinput="onSearch" bindconfirm="onSearch" />
    <text wx:if="{{keyword}}" class="search-clear" bindtap="clearSearch">×</text>
  </view>

  <view class="seg-wrap">
    <view
      wx:for="{{tabs}}"
      wx:key="tab"
      wx:for-item="tab"
      class="seg-item {{currentTab === tab.tab ? 'seg-active' : ''}}"
      data-tab="{{tab.tab}}"
      bindtap="onTabTap"
    >{{tab.label}}</view>
  </view>

  <scroll-view wx:if="{{filters.length}}" class="filter-scroll" scroll-x="true" enhanced="true" show-scrollbar="false">
    <view class="filter-row">
      <button class="filter-chip {{activeFilter === '' ? 'filter-active' : ''}}" data-filter="" bindtap="onFilterTap">全部</button>
      <button
        wx:for="{{filters}}"
        wx:key="*this"
        wx:for-item="filter"
        class="filter-chip {{activeFilter === filter ? 'filter-active' : ''}}"
        data-filter="{{filter}}"
        bindtap="onFilterTap"
      >{{filter}}</button>
    </view>
  </scroll-view>

  <view wx:if="{{items.length > 0}}" class="inventory-list">
    <view
      wx:for="{{items}}"
      wx:key="id"
      wx:for-item="it"
      class="inventory-card {{it.borderCls}}"
      data-index="{{index}}"
      bindtap="onItemTap"
    >
      <image class="card-icon" src="{{it.icon}}" data-index="{{index}}" mode="aspectFill" lazy-load="true" binderror="onIconError" />
      <view class="card-body">
        <view class="card-line">
          <text class="card-name">{{it.name}}</text>
          <text wx:if="{{it.chipCls}}" class="tag card-badge {{it.chipCls}}">{{it.chipLabel}}</text>
        </view>
        <text class="card-desc">{{it.desc}}</text>
        <text class="card-meta">{{it.metaText}}</text>
      </view>
      <text class="list-arrow">›</text>
    </view>
  </view>
  <view wx:elif="{{error}}" class="empty-wrap"><text>{{error}}</text></view>
  <view wx:else class="empty-wrap"><text>没有找到匹配的条目</text></view>

  <view wx:if="{{showDetail}}" class="mask" bindtap="closeDetail"></view>
  <view wx:if="{{showDetail}}" class="sheet">
    <view class="sheet-handle"></view>
    <button class="sheet-close" bindtap="closeDetail" aria-label="关闭">×</button>
    <image class="sheet-icon" src="{{detail.icon}}" mode="aspectFill" binderror="onDetailIconError" />
    <view class="sheet-title-row">
      <text class="sheet-name">{{detail.name}}</text>
      <text wx:if="{{detail.chipCls}}" class="tag {{detail.chipCls}}">{{detail.chipLabel}}</text>
      <text class="tag {{detail.categoryCls}}">{{detail.categoryLabel}}</text>
    </view>
    <text class="sheet-desc">{{detail.desc}}</text>
    <view class="sheet-meta">
      <view wx:for="{{detail.meta}}" wx:key="label" wx:for-item="m" class="sheet-meta-row">
        <text class="sheet-meta-label">{{m.label}}</text>
        <text class="sheet-meta-value">{{m.value}}</text>
      </view>
    </view>
  </view>
</view>
