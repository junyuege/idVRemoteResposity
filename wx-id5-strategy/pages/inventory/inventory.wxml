<view class="page-wrap">
  <view class="search-box">
    <text class="search-icon">⌕</text>
    <input class="search-input" placeholder="搜索形状或难度" placeholder-class="search-placeholder" bindinput="onSearch" bindconfirm="onSearch" />
    <text wx:if="{{keyword}}" class="search-clear" bindtap="clearSearch">×</text>
  </view>
  <view wx:if="{{items.length > 0}}" style="display:grid;grid-template-columns:repeat(2,1fr);gap:12px;">
    <view wx:for="{{items}}" wx:key="id" class="panel" style="padding:12px;" data-index="{{index}}" bindtap="onItemTap">
      <view style="display:flex;align-items:baseline;justify-content:space-between">
        <text style="font-size:14px;font-weight:600;color:#fff;">{{item.name}}</text>
      </view>
      <view style="margin-top:6px;font-size:12px;color:#aaa;">{{item.desc}}</view>
      <view style="font-size:11px;color:#999;margin-top:4px;display:flex;align-items:center;">
        <text class="tag {{item.rarityClass}}" style="margin-right:6px;">{{item.rarity}}</text>
        <text>{{item.price}} · 点击查看</text>
      </view>
    </view>
  </view>
  <view wx:else class="empty-wrap"><text>没有找到匹配的路线</text></view>
</view>