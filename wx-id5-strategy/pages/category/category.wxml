<view class="page-wrap category-page">
  <view class="category-title">选择地图</view>

  <view class="map-card" wx:for="{{maps}}" wx:key="id">
    <view class="map-icon-wrap">
      <view class="map-icon-star glow">✦</view>
    </view>
    <view class="map-name">{{item.displayName}}</view>
    <view class="map-diff">{{item.difficulty}}</view>
    <view class="mode-tabs">
      <view
        class="mode-tab {{currentMode === route.id ? 'active' : ''}}"
        wx:for="{{item.routes}}"
        wx:for-item="route"
        wx:key="id"
        data-mapId="{{item.id}}"
        data-routeId="{{route.id}}"
        bindtap="onModeTap"
      >{{route.name}}</view>
    </view>
  </view>
</view>