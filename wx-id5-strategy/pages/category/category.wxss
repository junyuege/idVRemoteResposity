.category-page { padding-top: 10px; }
.category-title {
  font-size: 22px;
  font-weight: 700;
  color: #ff9c00;
  margin: 0 0 24px 2px;
}
.map-card {
  background: #1e1e24;
  border-radius: 16px;
  padding: 28px 20px 24px;
  display: flex;
  flex-direction: column;
  align-items: center;
  border: 1px solid rgba(255,255,255,0.04);
}
.map-icon-wrap {
  width: 64px;
  height: 64px;
  border-radius: 50%;
  background: #2a2a33;
  border: 2px solid rgba(255, 156, 0, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12px;
  position: relative;
}
.map-icon-wrap::before {
  content: '';
  position: absolute;
  inset: -5px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255,156,0,0.12), transparent);
}
.map-icon-star {
  font-size: 30px;
  color: #ff9c00;
  filter: drop-shadow(0 0 10px rgba(255,156,0,0.5));
}
.map-name {
  color: #fff;
  font-size: 18px;
  font-weight: 600;
  margin-bottom: 20px;
}
.mode-tabs {
  display: flex;
  gap: 10px;
  width: 100%;
  justify-content: center;
  flex-wrap: wrap;
}
.mode-tab {
  padding: 8px 18px;
  border-radius: 20px;
  font-size: 13px;
  font-weight: 500;
  color: #ccc;
  background: #2a2a33;
  border: 1px solid rgba(255,255,255,0.06);
}
.mode-tab.active {
  background: #ff9c00;
  color: #121214;
  font-weight: 600;
  border-color: #ff9c00;
}